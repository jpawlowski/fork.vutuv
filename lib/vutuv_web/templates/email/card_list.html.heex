<div class="card__tablewrap">
<table>
  <thead>
    <tr>
      <th><%= gettext "Email" %></th>
      <th><%= gettext "Type" %></th>
      <%!-- The audience is the owner's own setting (issue #1521). On the public
            page it told a visitor nothing (every listed address was public) and
            with four rungs it would report the member's sharing choices to
            strangers, so the column is owner-only now. --%>
      <th :if={@as_owner?}><%= gettext "Visibility" %></th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <%= for email <- @emails do %>
    <tr>
      <td>
      <%= link email.value, to: ~p"/#{@user}/emails/#{email}" %>
      <%!-- Owner-only delivery warning: mail to this address bounced. A
            successful login PIN through the address clears it. --%>
      <span
        :if={@as_owner? && email.undeliverable_at}
        class="ml-2 text-sm font-semibold text-red-600 dark:text-red-400"
        title={gettext("Mail to this address bounced. Logging in with a PIN sent to it will clear this warning.")}
      >{gettext("Undeliverable")}</span>
      </td>
      <td><%= email_type_label(email.email_type) %></td>
      <td :if={@as_owner?}><%= visibility_label(email) %></td>
      <td class="text-right">
        <.row_actions
          :if={@as_owner?}
          edit_to={~p"/settings/emails/#{email}/edit"}
          delete_to={~p"/settings/emails/#{email}"}
        />
      </td>
    </tr>
<% end %>
  </tbody>
</table>
</div>