<.page_header
  title={display_number(@phone_number.value)}
  crumbs={[
    gettext("Users"),
    {full_name(@user), ~p"/#{@user}"},
    {gettext("Phone Numbers"), ~p"/#{@user}/phone_numbers"},
    display_number(@phone_number.value)
  ]}
/>

<.card_section>
  <.row_actions
    :if={same_user?(@user, @current_user)}
    class="mb-4"
    edit_to={~p"/settings/phone_numbers/#{@phone_number}/edit"}
    delete_to={~p"/settings/phone_numbers/#{@phone_number}"}
  />

  <h2 class="card__label"><%= gettext("Number Type") %></h2>
  <p><%= phone_type_label(@phone_number.number_type) %></p>
  <h2 class="card__label"><%= gettext("Number") %></h2>
  <p><a href={"tel:" <> tel_href(@phone_number.value)}><%= display_number(@phone_number.value) %></a></p>
  <%!-- Owner-only: who this number reaches is the owner's setting (issue #1521),
        and a visitor only ever lands here for a number they may already see. --%>
  <%= if same_user?(@user, @current_user) do %>
    <h2 class="card__label"><%= gettext("Who can see it") %></h2>
    <p><%= visibility_label(@phone_number) %></p>
  <% end %>
</.card_section>
